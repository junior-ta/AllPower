ALLPOWER_TOKEN=replace-with-a-random-token
ALLPOWER_HOSPITAL_TOKEN=
ALLPOWER_SUPPLIER_TOKEN=
ALLPOWER_ADVICE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional local llama.cpp-compatible chat endpoint, used only when provider=llama.
ALLPOWER_LLAMA_URL=
ALLPOWER_LLAMA_MODEL=granite
# After inspecting the LinuxONE image, replace latest with its verified digest.
ALLPOWER_BASE_IMAGE=registry.linuxone.cloud.marist.edu/l1cc/jupyterlab-image-s390x:latest
# Optional: validated official hourly demand CSV mounted under ./data.
ALLPOWER_DEMAND_CSV=
ALLPOWER_DEMAND_PROVENANCE=
